RewriteEngine On

# Redirige /page vers /page.php si le fichier existe
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)$ $1.php [L,QSA]

# -----------------------------------------------------------------------
# HTTP/2 — IMPORTANT : la directive Protocols ne peut s'activer que depuis
# httpd.conf ou la config VirtualHost (pas depuis .htaccess).
# Pour activer HTTP/2 :
#   1. Apache : charger mod_http2, puis ajouter dans le VirtualHost :
#        Protocols h2 http/1.1
#   2. Nginx (reverse proxy) : ajouter dans le bloc server :
#        listen 443 ssl http2;
# -----------------------------------------------------------------------
<IfModule mod_http2.c>
    # Protocols h2 h2c http/1.1  # Déplacer dans httpd.conf/VirtualHost pour activer
    # H2Push : précharge les ressources critiques dès la réponse HTML
    # (actif seulement quand HTTP/2 est effectivement activé côté serveur)
    <FilesMatch "^(index|portraits|tracesdupasse|derriere-le-documentaire|mentionslegales|souvenirs)\.php$">
        H2PushResource add /css/font.css
        H2PushResource add /css/typography.css
        H2PushResource add /css/main.css
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------
# Compression Brotli (prioritaire) puis Gzip
# -----------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
        application/javascript text/javascript application/json \
        image/svg+xml text/xml application/xml font/ttf font/woff font/woff2
    BrotliCompressionQuality 6
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css \
        application/javascript text/javascript application/json \
        image/svg+xml text/xml application/xml font/ttf font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------------
# Cache long terme pour les ressources statiques
# -----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                        "access plus 1 week"

    # HTML / PHP (pas de cache ou très court)
    ExpiresByType text/html               "access plus 0 seconds"
    ExpiresByType application/xhtml+xml   "access plus 0 seconds"

    # CSS / JS
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType text/javascript         "access plus 1 month"

    # Polices — immuables sur le long terme
    ExpiresByType font/ttf                "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/font-woff   "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"

    # Images
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"

    # Vidéos
    ExpiresByType video/mp4               "access plus 1 month"
    ExpiresByType video/webm              "access plus 1 month"

    # Audio
    ExpiresByType audio/mpeg              "access plus 1 month"
    ExpiresByType audio/mp3               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Sécurité : supprimer le header qui révèle la stack serveur
    Header always unset X-Powered-By

    # HSTS : forcer HTTPS pendant 1 an, sous-domaines inclus, éligible preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Polices : cache immuable (le nom de fichier ne change pas souvent)
    <FilesMatch "\.(ttf|woff|woff2|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS et JS : cache 1 mois
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Images et vidéos
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(mp4|webm|mp3)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Désactiver le cache pour les pages PHP dynamiques
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Note : Vary: Accept-Encoding est déjà envoyé par Nginx (gzip_vary on)
    # — ne pas le dupliquer ici pour éviter le double header Vary
</IfModule>
